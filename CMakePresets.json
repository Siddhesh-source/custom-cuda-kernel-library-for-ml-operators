{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release, sm_75 (Kaggle T4), Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CCML_CUDA_ARCHITECTURES": "75"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug, sm_75 (Kaggle T4), Ninja (device debug info; use for compute-sanitizer)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CCML_CUDA_ARCHITECTURES": "75"
      }
    },
    {
      "name": "local",
      "displayName": "Release, sm_89 (local RTX 3050 A, docs/local.md items only), Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/local",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CCML_CUDA_ARCHITECTURES": "89"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "local",
      "configurePreset": "local"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "local",
      "configurePreset": "local",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "build",
      "displayName": "Configure and build everything",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        }
      ]
    },
    {
      "name": "default",
      "displayName": "Configure, build, and run every correctness test",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        },
        {
          "type": "test",
          "name": "default"
        }
      ]
    },
    {
      "name": "debug",
      "displayName": "Debug build with synchronous launch checks, then test",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "local",
      "displayName": "Local sm_89: configure, build, test",
      "steps": [
        {
          "type": "configure",
          "name": "local"
        },
        {
          "type": "build",
          "name": "local"
        },
        {
          "type": "test",
          "name": "local"
        }
      ]
    }
  ]
}
